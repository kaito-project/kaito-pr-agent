{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "clusterName": {
      "value": "${clusterName}"
    },
    "nodeResourceGroup": {
      "value": "${nodeResourceGroup}"
    },
    "albSubnetAddressPrefix": {
      "value": "${albSubnetAddressPrefix}"
    },
    "albIdentityPrincipalId": {
      "value": "${albIdentityPrincipalId}"
    },
    "albIdentityResourceId": {
      "value": "${albIdentityResourceId}"
    },
    "kaitoProvisionerIdentityPrincipalId": {
      "value": "${kaitoProvisionerIdentityPrincipalId}"
    },
    "kaitoProvisionerIdentityResourceId": {
      "value": "${kaitoProvisionerIdentityResourceId}"
    },
    "clusterResourceId": {
      "value": "${clusterResourceId}"
    }
  }
}